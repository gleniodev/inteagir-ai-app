# Desativado por padrão. Não preencher com credenciais existentes de Codex/agy.
# Ativar somente após configuração local autorizada de uma instância Hermes
# dedicada, sem ferramentas habilitadas e sem adoção de logins externos.
INTEAGIR_HERMES_ENABLED=false
# Imagem OAuth pelo provedor Hermes/cliente oficial Codex dedicado.
# Ativar após login e gate real. Somente GPT/OpenAI OAuth.
INTEAGIR_HERMES_IMAGE_ENABLED=false
INTEAGIR_HERMES_URL=http://127.0.0.1:8642
INTEAGIR_HERMES_TOKEN=
INTEAGIR_HERMES_MODEL=
